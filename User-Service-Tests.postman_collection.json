		{
			"name": "5. Add Education",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 or 201\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"pm.test(\"Response should have degree info\", function() {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.degree).to.eql(\"Cử nhân Test\");",
							"});",
							"// Save education ID for update/delete later",
							"if(pm.response.code === 200 || pm.response.code === 201) {",
							"    var data = pm.response.json();",
							"    pm.environment.set(\"EDUCATION_ID\", data.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
