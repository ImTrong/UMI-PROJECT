# =================================================================
# UMI E-LEARNING PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# Rename this file to .env and fill in your actual values.
# DO NOT commit the .env file with real production secrets to Git!
# =================================================================

# Node Environment
NODE_ENV=development

# Internal microservice communication secret token
INTERNAL_SERVICE_TOKEN=your_internal_service_secret_token_here

# AI Service (Google Gemini API Key - free at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Stripe Payment Gateway (Card payments)
# Obtain test/live keys at https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# payOS Payment Gateway (VietQR Bank Transfer)
# Obtain API credentials at https://my.payos.vn/
# NOTE: payOS currently runs in production mode. Use mocks during automated testing.
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:3000/checkout/success

# Frontend Public URLs
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:4000

# Blockchain Certificate Verification (Polygon Amoy Testnet)
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology/
BLOCKCHAIN_PRIVATE_KEY=your_blockchain_wallet_private_key
BLOCKCHAIN_CONTRACT_ADDRESS=your_deployed_contract_address
