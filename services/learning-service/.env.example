PORT=3006
NODE_ENV=development
DATABASE_URL="mongodb://admin:securepassword123@mongodb:27017/learning_db?authSource=admin"
AUTH_SERVICE_URL="http://auth-service:3001"
USER_SERVICE_URL="http://user-service:3002"
COURSE_SERVICE_URL="http://course-service:3003"
ORDER_SERVICE_URL="http://order-service:3004"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://localhost:3007"
CERTIFICATE_STORAGE_PATH="./certificates"
BASE_URL="http://learning-service:3006"

# MinIO Configuration
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_PUBLIC_URL=http://localhost:9000

# Video Streaming Configuration
MINIO_VIDEO_BUCKET=course-videos
PRESIGNED_URL_EXPIRY=60

# HLS Processing Configuration
HLS_TEMP_DIR=/tmp/hls-processing
VIDEO_UPLOAD_DIR=/tmp/video-uploads
MAX_VIDEO_SIZE_MB=2048

# AI Service (for evaluation pipeline)
AI_SERVICE_URL=http://ai-service:3007

# Project Analysis Configuration (Phase 1)
ZIP_UPLOAD_DIR=/tmp/project-uploads
ZIP_EXTRACT_DIR=/tmp/project-analysis

# Blockchain Certificate Verification
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=polygon-amoy
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
# Shared secret for service-to-service calls (leaderboard eligibility lookup to user-service, internal enroll endpoint)
INTERNAL_SERVICE_TOKEN=your_internal_service_secret_token_here

# --- Monthly leaderboard finalization lock (FIX 06B2) ---
# Lease length of the per-period lock, in ms (1000..600000). A snapshot of ~100k students takes ~30 s to write on a local
# replica set: raise this (and keep the heartbeat <= TTL/3) before running much larger periods.
LEADERBOARD_LOCK_TTL_MS=60000
# How often the owner renews its lease, in ms (>= 100 and <= TTL/3).
LEADERBOARD_LOCK_HEARTBEAT_MS=20000
# Period of the reconciliation of unfinished past months, in ms (0 disables). Keep it above the lock TTL.
LEADERBOARD_RECONCILE_INTERVAL_MS=300000

# --- FIX-INS-03 ----------------------------------------------------------------------------------
# Course -> Learning credential: the ONLY token accepted by GET /api/learning/progress/course/:courseId/students[/:userId]
# (X-Internal-Service-Token). Must be the SAME value as COURSE_LEARNING_TOKEN in course-service, different from INTERNAL_SERVICE_TOKEN.
# Unset / shorter than 24 characters / a public default = every call is refused with 500 (fail-closed).
# FIX-INS-06: this service also SENDS it to the course-service's internal routes (lessons with videoUrl, recommendations/batch);
# without a usable value those calls are not sent (they fail like a course-service outage). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COURSE_LEARNING_TOKEN=

# --- FIX-INS-04 ----------------------------------------------------------------------------------
# Order <-> Learning credential: the ONLY token accepted by POST /api/learning/internal/courses/:courseId/enroll, and the token
# this service sends to the order-service's read-only GET /api/orders/internal/:orderId/entitlement (payment proof). Must be the
# SAME value as ORDER_LEARNING_TOKEN in order-service, different from INTERNAL_SERVICE_TOKEN. Unset / shorter than 24 characters /
# a public default = every paid enrollment is refused (fail-closed). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_LEARNING_TOKEN=
ORDER_SERVICE_URL=http://order-service:3004

# --- FIX-INS-05 ----------------------------------------------------------------------------------
# AI -> Learning credential: the ONLY token accepted by GET /api/learning/internal/skill-profile/:userId,
# GET /api/learning/internal/learner-analysis/:userId and POST /api/learning/internal/learner-analysis/:userId/invalidate
# (X-Internal-Service-Token). Must be the SAME value as AI_LEARNING_TOKEN of the ai-service, different from every other token.
# Unset / shorter than 24 characters / a public default = every call is refused with 500 (fail-closed). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_LEARNING_TOKEN=

# --- FIX-INS-14 ----------------------------------------------------------------------------------
# HMAC key of the short-lived learning-path image URLs (/api/learning/path-images/...?exp=&sig=). Must be the SAME on every
# instance and stable across restarts (a new value invalidates the URLs already handed out - they live 15 minutes).
# Unset / shorter than 32 characters / equal to a service credential = no upload URL (500), non-published path images are not
# displayed; there is no generated fallback. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PATH_IMAGE_SIGNING_SECRET=
