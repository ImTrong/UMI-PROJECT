PORT=3006
NODE_ENV=development
DATABASE_URL="mongodb://admin:securepassword123@mongodb:27017/learning_db?authSource=admin"
AUTH_SERVICE_URL="http://auth-service:3001"
USER_SERVICE_URL="http://user-service:3002"
COURSE_SERVICE_URL="http://course-service:3003"
ORDER_SERVICE_URL="http://order-service:3004"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://localhost:3007"
CERTIFICATE_STORAGE_PATH="./certificates"
BASE_URL="http://learning-service:3006"

# MinIO Configuration
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_PUBLIC_URL=http://localhost:9000

# Video Streaming Configuration
MINIO_VIDEO_BUCKET=course-videos
PRESIGNED_URL_EXPIRY=60

# HLS Processing Configuration
HLS_TEMP_DIR=/tmp/hls-processing
VIDEO_UPLOAD_DIR=/tmp/video-uploads
MAX_VIDEO_SIZE_MB=2048

# AI Service (for evaluation pipeline)
AI_SERVICE_URL=http://ai-service:3007

# Project Analysis Configuration (Phase 1)
ZIP_UPLOAD_DIR=/tmp/project-uploads
ZIP_EXTRACT_DIR=/tmp/project-analysis

# Blockchain Certificate Verification
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=polygon-amoy
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
