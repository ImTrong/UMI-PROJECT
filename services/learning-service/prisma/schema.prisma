generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model UserProgress {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @unique @db.ObjectId
  totalCoursesEnrolled Int   @default(0)
  totalCoursesCompleted Int  @default(0)
  totalLessonsCompleted Int  @default(0)
  totalStudyTime     Int     @default(0)
  streakDays         Int     @default(0)
  lastActivityDate   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  courses           CourseProgress[]
  certificates      Certificate[]
  badges            Badge[]
  activities        ActivityLog[]
  
  @@map("user_progress")
}

model CourseProgress {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String   @db.ObjectId
  courseId            String   @db.ObjectId
  courseTitle         String
  enrolledAt          DateTime @default(now())
  completedAt         DateTime?
  progressPercentage  Float    @default(0)
  totalLessons        Int      @default(0)
  completedLessons    Int      @default(0)
  timeSpentSeconds    Int      @default(0)
  lastAccessedAt      DateTime @default(now())
  averageQuizScore    Float?              // Điểm trung bình quiz của khóa
  passed              Boolean?            // Khóa học đạt/không đạt
  allowRetake         Boolean  @default(false) // Cho phép học lại miễn phí
  passingScore        Float    @default(80)    // Ngưỡng điểm đạt (mặc định 80%)
  retakeCount         Int      @default(0)     // Số lần đã học lại
  
  lessons             LessonProgress[]
  userProgress        UserProgress @relation(fields: [userId], references: [userId], onDelete: Cascade)
  
  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("course_progress")
}

model LessonProgress {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  courseId         String   @db.ObjectId
  lessonId         String   @db.ObjectId
  lessonTitle      String
  completed        Boolean  @default(false)
  completedAt      DateTime?
  timeSpentSeconds Int      @default(0)
  lastWatchedAt    DateTime @default(now())
  watchCount       Int      @default(0)
  
  courseProgress   CourseProgress @relation(fields: [userId, courseId], references: [userId, courseId])
  
  @@unique([userId, courseId, lessonId])
  @@index([userId])
  @@index([courseId])
  @@index([completed])
  @@map("lesson_progress")
}

model Certificate {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  certificateNumber String        @unique
  userId          String          @db.ObjectId
  courseId        String?         @db.ObjectId  // nullable for path certificates
  learningPathId  String?         @db.ObjectId  // for path certificates
  courseTitle     String                        // course title or path title
  userName        String
  type            CertificateType @default(COURSE_COMPLETION)
  averageScore    Float?                        // Điểm trung bình
  issueDate       DateTime        @default(now())
  expiresAt       DateTime?
  certificateUrl  String?
  verificationUrl String?
  isVerified      Boolean         @default(true)
  metadata        Json            @default("{}")
  createdAt       DateTime        @default(now())
  
  userProgress    UserProgress @relation(fields: [userId], references: [userId], onDelete: Cascade)
  
  @@unique([userId, courseId, learningPathId])
  @@index([userId])
  @@index([courseId])
  @@index([learningPathId])
  @@index([type])
  @@map("certificates")
}

enum CertificateType {
  COURSE_COMPLETION   // Chứng nhận hoàn thành khóa học
  PATH_CERTIFICATE    // Chứng chỉ hoàn thành lộ trình
}

model Badge {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  badgeName   String
  badgeType   String
  description String?
  iconUrl     String?
  earnedAt    DateTime @default(now())
  metadata    Json     @default("{}")
  
  userProgress UserProgress @relation(fields: [userId], references: [userId], onDelete: Cascade)
  
  @@unique([userId, badgeName])
  @@index([userId])
  @@index([badgeType])
  @@map("badges")
}

model ActivityLog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  courseId        String?  @db.ObjectId
  lessonId        String?  @db.ObjectId
  action          String
  durationSeconds Int      @default(0)
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  
  userProgress    UserProgress @relation(fields: [userId], references: [userId], onDelete: Cascade)
  
  @@index([userId])
  @@index([courseId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// ==================== Quiz System ====================

model Quiz {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  courseId       String       @db.ObjectId
  lessonId      String       @db.ObjectId
  title         String
  description   String?
  questions     Json         // Array of QuizQuestion objects
  passingScore  Float        @default(70)
  timeLimitMinutes Int?      // null = no time limit
  maxAttempts   Int          @default(3)
  shuffleQuestions Boolean   @default(false)
  createdBy     String       @db.ObjectId
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  attempts      QuizAttempt[]

  @@unique([lessonId])
  @@index([courseId])
  @@index([createdBy])
  @@map("quizzes")
}

model QuizAttempt {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  quizId        String           @db.ObjectId
  userId        String           @db.ObjectId
  courseId       String           @db.ObjectId
  answers       Json             // User's answers
  score         Float            @default(0)
  totalQuestions Int             @default(0)
  correctAnswers Int             @default(0)
  passed        Boolean          @default(false)
  status        QuizAttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime         @default(now())
  submittedAt   DateTime?
  timeTakenSeconds Int?

  quiz          Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@index([userId, quizId])
  @@map("quiz_attempts")
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
}

// ==================== Assignment System ====================

model Assignment {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  courseId       String       @db.ObjectId
  lessonId      String       @db.ObjectId
  title         String
  description   String
  instructions  String?
  maxScore      Float        @default(100)
  dueDate       DateTime?
  allowLateSubmission Boolean @default(false)
  allowedFileTypes String[]  @default(["pdf", "doc", "docx", "zip", "png", "jpg"])
  maxFileSizeMB Int          @default(10)
  createdBy     String       @db.ObjectId
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  submissions   AssignmentSubmission[]

  @@unique([lessonId])
  @@index([courseId])
  @@index([createdBy])
  @@map("assignments")
}

model AssignmentSubmission {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  assignmentId  String              @db.ObjectId
  userId        String              @db.ObjectId
  courseId       String              @db.ObjectId
  content       String?             // Text content
  fileUrl       String?             // MinIO file URL
  fileKey       String?             // MinIO file key
  fileName      String?
  status        SubmissionStatus    @default(SUBMITTED)
  score         Float?
  feedback      String?
  gradedBy      String?             @db.ObjectId
  gradedAt      DateTime?
  submittedAt   DateTime            @default(now())
  isLate        Boolean             @default(false)

  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([assignmentId])
  @@index([userId])
  @@index([status])
  @@map("assignment_submissions")
}

enum SubmissionStatus {
  SUBMITTED
  GRADING
  GRADED
  RETURNED
}

// ==================== Video Processing (HLS) ====================

model VideoProcessingJob {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  lessonId         String          @db.ObjectId
  courseId          String          @db.ObjectId
  inputFilePath    String
  originalFileName String
  uploadedBy       String          @db.ObjectId
  status           String          @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  hlsPath          String?         // MinIO path to master.m3u8
  segmentCount     Int?
  durationSeconds  Int?
  totalSizeBytes   Int?
  errorMessage     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([lessonId])
  @@index([courseId])
  @@index([status])
  @@index([uploadedBy])
  @@map("video_processing_jobs")
}

// ==================== Learning Paths ====================

model LearningPath {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String
  slug            String               @unique
  category        String?              // e.g. "Công nghệ thông tin", "Kinh doanh"
  difficulty      String               @default("ALL") // "BEGINNER", "INTERMEDIATE", "ADVANCED", "ALL"
  imageUrl        String?
  shortDescription String?
  bannerUrl       String?
  careerGoal      String?
  skills          Json                 @default("[]")
  prerequisiteRules Json?              // { courseId: string, requiredCourseIds: string[] }[]
  completionRule  String               @default("ALL_COURSES") // "ALL_COURSES", "MIN_PERCENT:80"
  recommended     Boolean              @default(false)
  status          String               @default("DRAFT") // "DRAFT", "PUBLISHED", "ARCHIVED"
  totalDurationMinutes Int             @default(0)
  enrollmentCount Int                  @default(0)
  createdBy       String?              @db.ObjectId
  courseIds       String[]             // List of Course IDs in milestone order
  certificateConfig Json?              // Custom certificate configuration (title, subtitle, signer, org, etc.)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  
  userEnrollments UserPathEnrollment[]

  @@map("learning_paths")
}

model UserPathEnrollment {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  userId         String       @db.ObjectId
  learningPathId String       @db.ObjectId
  status         String       @default("IN_PROGRESS") // "IN_PROGRESS", "COMPLETED"
  enrolledAt     DateTime     @default(now())
  completedAt    DateTime?
  lastUpdatedAt  DateTime     @updatedAt

  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  @@unique([userId, learningPathId])
  @@index([userId])
  @@map("user_path_enrollments")
}

// ==================== Study Schedule ====================

model StudySchedule {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @unique
  slots              Json     // Array of OptimalScheduleSlot objects
  weeklyTargetHours  Int      @default(5)
  dailyTargetMinutes Int      @default(30)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@map("study_schedules")
}

// ==================== Final Project (Lộ trình) ====================

model FinalProject {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  learningPathId  String   @db.ObjectId
  title           String
  description     String
  instructions    String?
  objectives      String?              // Mục tiêu đầu ra cần đạt
  references      Json?                // Tài liệu tham khảo [{title, url}]
  maxScore        Float    @default(100)
  passingScore    Float    @default(80)   // ≥80% để nhận chứng chỉ
  allowedFileTypes String[] @default(["pdf", "doc", "docx", "zip", "rar", "png", "jpg"])
  maxFileSizeMB   Int      @default(50)
  maxAttempts     Int      @default(3)    // Số lần được phép nộp lại
  deadline        DateTime?              // Thời hạn nộp bài
  submissionTypes Json?                  // Cấu hình loại bài nộp do Admin thiết lập
  // submissionTypes structure:
  // [{
  //   type: "FILE" | "IMAGE" | "VIDEO" | "AUDIO" | "GITHUB_LINK" | "DEMO_LINK" | "FIGMA_LINK" | "TEXT" | "CUSTOM",
  //   label: "Tệp tin PDF",
  //   description?: "Upload file báo cáo dạng PDF",
  //   required: true,
  //   accept?: ".pdf,.doc,.docx",  // For FILE/IMAGE/VIDEO/AUDIO types
  //   maxSizeMB?: 50,              // For file uploads
  //   placeholder?: "https://github.com/...",  // For link/text types
  // }]
  evaluationPipeline Json?              // Evaluation Pipeline (Array of Stage objects)
  // evaluationPipeline structure:
  // [{
  //   stageNumber: 1,
  //   title: "Kiểm tra cấu trúc Project",
  //   objective: "Đảm bảo project có cấu trúc folder chuẩn",
  //   criteria: "README.md, src/, package.json tồn tại",
  //   maxScore: 20,
  //   weight: 0.15,
  //   passCriteria: "Đạt ≥ 70% tiêu chí"
  // }]
  createdBy       String   @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions     FinalProjectSubmission[]

  @@unique([learningPathId])
  @@map("final_projects")
}

model FinalProjectSubmission {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  finalProjectId  String           @db.ObjectId
  userId          String           @db.ObjectId
  learningPathId  String           @db.ObjectId
  attemptNumber   Int              @default(1)    // Lần nộp thứ mấy
  content         String?          // Text content / description
  githubUrl       String?          // Link GitHub repo
  demoUrl         String?          // Link Demo
  fileUrl         String?          // MinIO file URL
  fileKey         String?          // MinIO file key
  fileName        String?
  submissionData  Json?            // Dữ liệu bài nộp đa loại theo cấu hình Admin
  // submissionData structure:
  // [{
  //   type: "FILE" | "IMAGE" | "VIDEO" | "AUDIO" | "GITHUB_LINK" | "DEMO_LINK" | "FIGMA_LINK" | "TEXT" | "CUSTOM",
  //   label: "Tệp tin PDF",
  //   value: "url hoặc text content",
  //   fileName?: "report.pdf",
  //   fileKey?: "final-projects/xxx/report.pdf",
  //   fileSize?: 1024000
  // }]
  sourceZipUrl    String?          // MinIO URL for uploaded source ZIP
  sourceZipKey    String?          // MinIO key for source ZIP
  processingStatus String         @default("UPLOADED") // UPLOADED, ANALYZING, READY_FOR_EVALUATION, EVALUATING, COMPLETED, FAILED
  processingError String?          // Error message if processing failed
  projectContext  Json?            // Computed Project Context for AI evaluation (metadata + structure + artifacts + source index)
  status          SubmissionStatus @default(SUBMITTED)
  score           Float?
  totalScore      Float?           // Tổng điểm tính theo trọng số pipeline
  stageResults    Json?            // Kết quả từng stage [{stageNumber, title, score, maxScore, weightedScore, passed, feedback, details}]
  feedback        String?
  aiFeedback      String?          // AI-generated feedback report
  gradedBy        String?          @db.ObjectId
  gradedAt        DateTime?
  submittedAt     DateTime         @default(now())

  finalProject    FinalProject @relation(fields: [finalProjectId], references: [id], onDelete: Cascade)

  @@unique([finalProjectId, userId, attemptNumber])
  @@index([userId])
  @@index([learningPathId])
  @@index([processingStatus])
  @@map("final_project_submissions")
}

// ==================== Project Analysis (Phase 1: AI Project Review) ====================

model ProjectAnalysis {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  submissionId      String   @unique @db.ObjectId
  learningPathId    String   @db.ObjectId
  userId            String   @db.ObjectId

  // Project metadata
  projectType       String?              // "web-app", "api", "mobile", "cli", "library", "fullstack"
  primaryLanguage   String?              // "TypeScript", "JavaScript", "Python", etc.
  languages         String[] @default([])
  frameworks        String[] @default([])
  libraries         String[] @default([])

  // Structure analysis
  directoryStructure Json?               // Nested directory tree {name, type, children}
  totalFiles        Int      @default(0)
  totalLines        Int      @default(0)
  analyzedFiles     Int      @default(0)

  // Collected artifacts
  readmeContent     String?              // README.md content (truncated if too long)
  packageInfo       Json?                // package.json / requirements.txt parsed data
  configFiles       Json?                // [{path, type, content}] — key config files

  // Source file index — NO AI summarization, direct analysis only
  // [{path, language, lineCount, imports[], exports[], isEntryPoint, directory}]
  sourceFileIndex   Json?

  // Code chunks — retrievable segments for rubric-based evaluation in Phase 2
  // [{filePath, chunkIndex, startLine, endLine, content, language}]
  codeChunks        Json?

  // Entry points detected
  entryPoints       String[] @default([])

  // GitHub-specific info (when submitted via GitHub URL)
  githubInfo        Json?                // {repoUrl, stars, commits, branches, lastCommitDate, contributors}

  // Processing metadata
  processingStatus  String   @default("PENDING") // PENDING, ANALYZING, COMPLETED, FAILED
  errorMessage      String?
  analysisVersion   String   @default("1.0")
  analyzedAt        DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([processingStatus])
  @@map("project_analyses")
}

// ==================== Project Evaluation (Phase 2: AI Rubric Evaluation) ====================

model ProjectEvaluation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  submissionId    String   @db.ObjectId
  learningPathId  String   @db.ObjectId
  userId          String   @db.ObjectId

  // Kết quả tổng
  totalScore      Float                // Tổng điểm weighted (0-100)
  passingScore    Float                // Ngưỡng đạt
  passed          Boolean              // Backend tính: totalScore >= passingScore

  // Kết quả từng criterion (structured JSON with snapshot)
  // [{criterionId, title, maxScore, weight, passCriteria, score, weightedScore, passed,
  //   evidenceUsed: [{chunkId, filePath, startLine, endLine}],
  //   strengths[], weaknesses[], feedback, suggestions[]}]
  criterionResults Json

  // Tổng hợp
  passedCriteria    String[] @default([])  // Tên các criterion đã đạt
  failedCriteria    String[] @default([])  // Tên các criterion chưa đạt
  overallStrengths  String[] @default([])  // Điểm mạnh tổng hợp
  overallWeaknesses String[] @default([])  // Điểm cần cải thiện

  // Feedback report
  feedbackReport  String?                  // AI-generated comprehensive report

  // Metadata
  evaluationVersion String  @default("2.0")
  evaluatedAt     DateTime  @default(now())

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([submissionId])
  @@index([userId])
  @@index([learningPathId])
  @@map("project_evaluations")
}

// ==================== User Skill Profile (Phase 3: Skill-based Evaluation) ====================

model UserSkillProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId

  // Skill data — array of canonical skill entries
  // [{
  //   canonicalName: "react", displayName: "React", category: "Frontend",
  //   level: "INTERMEDIATE", confidence: 0.85,
  //   evidences: [{source, sourceId, detail, scorePercentage, weight, date}],
  //   lastUpdated: "2024-..."
  // }]
  skills        Json      @default("[]")

  // Tổng hợp điểm mạnh/yếu từ evaluations
  strengths     String[]  @default([])
  weaknesses    String[]  @default([])

  // Summary cho dashboard
  overallLevel        String?   // "BEGINNER" | "INTERMEDIATE" | "ADVANCED"
  profileCompleteness Int       @default(0)  // 0-100

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("user_skill_profiles")
}

// ==================== Learner Analysis (Competency Profile Cache) ====================

model LearnerAnalysis {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId

  // LearnerCompetencyProfile JSON — kết quả phân tích tổng hợp
  profile         Json

  // Cache management
  dataVersion     Int      @default(1)           // Tăng khi schema thay đổi
  analyzedAt      DateTime @default(now())       // Thời điểm phân tích
  expiresAt       DateTime                       // TTL fallback (6 giờ)
  invalidatedAt   DateTime?                      // Event-driven invalidation timestamp

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
  @@index([invalidatedAt])
  @@map("learner_analyses")
}

// ==================== Monthly Leaderboard & Achievements ====================

model MonthlyLeaderboard {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  month              Int       // 1-12
  year               Int       // e.g. 2026
  status             String    @default("ACTIVE") // ACTIVE, FINALIZING, FINALIZED, FAILED
  finalizedAt        DateTime?
  finalizedBy        String?   // "SYSTEM_CRON" or adminId
  totalParticipants  Int       @default(0)
  totalPointsAwarded Int       @default(0)
  policyVersion      String    @default("1.0")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // ---- Distributed lock for finalization (see src/services/leaderboard-lock.service.ts) ----
  // All optional: rows written before the lock existed simply have none of these fields.
  lockOwner          String?   // human-readable identity of the holder (host:pid:...) - informational only
  lockToken          String?   // random per-acquisition secret (>=128 bit); the holder proves ownership with it
  lockExpiresAt      DateTime? // lease end, always computed from the MongoDB server clock
  fencingToken       Int?      // monotonic: +1 on every acquire / take-over; absent == 0
  lockHeartbeatAt    DateTime? // last renew / fenced write (informational; never used to decide expiry)
  fenceSeq           Int?      // bumped by every fenced transaction so the fence is always a REAL write (a no-op update takes no conflict)

  entries     LeaderboardEntry[]

  @@unique([month, year])
  @@map("monthly_leaderboards")
}

model LeaderboardEntry {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  leaderboardId     String   @db.ObjectId
  userId            String   @db.ObjectId
  rank              Int
  points            Float    @default(0)       // Tổng điểm thành tích tháng
  completedCourses  Int      @default(0)
  averageScore      Float?                     // Điểm trung bình quiz (chỉ tính khóa có quiz)
  lastCompletedAt   DateTime
  rewardPoints      Int      @default(0)       // Điểm thưởng nhận được (1000, 700, 500, 200, 0)
  rewardBadgeId     String?  @db.ObjectId      // Reference to Badge if rewarded
  scoreBreakdown    Json     @default("[]")    // Chi tiết điểm từng khóa học đóng góp
  isTie             Boolean  @default(false)   // Đánh dấu nếu đồng hạng
  rewardNotifiedAt  DateTime?                  // Thông báo thưởng đã gửi thành công (chỉ để chống gửi lặp khi retry)
  rewardNotifyError String?                    // Lỗi gửi thông báo gần nhất (null khi đã gửi); dùng để gửi lại sau
  // Claim so that only ONE process sends a given notification at a time (see LeaderboardService.claimNotification).
  // A claim lapses at rewardNotifyClaimExpiresAt, so a crashed sender never blocks a retry for ever.
  rewardNotifyClaimToken     String?           // random token of the process that currently owns the right to send
  rewardNotifyClaimExpiresAt DateTime?         // when that claim lapses

  leaderboard       MonthlyLeaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  @@unique([leaderboardId, userId])
  @@index([leaderboardId, rank])
  @@map("leaderboard_entries")
}

// ==================== Course Completion & Achievement History ====================

model CourseCompletionRecord {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  userId               String   @db.ObjectId
  courseId             String   @db.ObjectId
  courseTitle          String
  completedAt          DateTime
  passed               Boolean  @default(true)
  totalDurationSeconds Int      @default(0)
  level                String   @default("BEGINNER")
  baseDurationPoints   Float    @default(0)
  levelMultiplier      Float    @default(1.0)
  achievementPoints    Float    @default(0)
  averageQuizScore     Float?
  hasQuiz              Boolean  @default(false)
  policyVersion        String   @default("1.0")
  pointsBreakdown      Json     @default("{}")
  status               String   @default("VALID") // "VALID" | "SUSPECT" | "EXCLUDED"
  month                Int      // Kỳ tháng (Asia/Ho_Chi_Minh)
  year                 Int      // Kỳ năm (Asia/Ho_Chi_Minh)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId, month, year])
  @@index([month, year, status])
  @@map("course_completion_records")
}

// ==================== Reward Point Ledger & Transactions ====================

model UserRewardPoint {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  balance     Int      @default(0) // Số dư điểm thưởng hiện tại (phi tiền tệ)
  totalEarned Int      @default(0)
  totalSpent  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_reward_points")
}

model RewardPointTransaction {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  amount         Int      // Dương nếu cộng, âm nếu trừ
  type           String   // "LEADERBOARD_REWARD" | "COURSE_REDEMPTION" | "COURSE_REDEMPTION_REFUND" | "ADMIN_ADJUSTMENT"
  description    String
  balanceAfter   Int
  sourceId       String?  // leaderboardId hoặc courseId
  idempotencyKey String?  @unique
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type])
  @@map("reward_point_transactions")
}

/// One row per (user, course) point redemption. It is the business-level claim that
/// guarantees a course can be paid for with points only once at a time, and it makes
/// unfinished redemptions queryable for crash recovery.
/// status: PENDING_ENROLLMENT | COMPLETED | REFUNDED
model CourseRedemption {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  userId              String    @db.ObjectId
  courseId            String    @db.ObjectId
  status              String
  pointsCharged       Int
  transactionId       String    @db.ObjectId // ledger entry of the debit
  refundTransactionId String?   @db.ObjectId // ledger entry of the refund (if any)
  attempts            Int       @default(0)
  lastError           String?
  leaseUntil          DateTime? // processing lease: only the holder may enroll / refund
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([status, updatedAt])
  @@map("course_redemptions")
}

// ==================== Leaderboard Admin Audit Logs ====================

model LeaderboardAuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId      String   @db.ObjectId
  adminEmail   String
  action       String   // "MANUAL_FINALIZE" | "ADJUST_POINTS" | "FLAG_STUDENT" | "RESTORE_STUDENT" | "SYNC_COMPLETIONS"
  targetUserId String?  @db.ObjectId
  month        Int?
  year         Int?
  reason       String
  details      Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([month, year])
  @@index([adminId])
  @@map("leaderboard_audit_logs")
}

