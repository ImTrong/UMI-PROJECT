PORT=3003
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/course_db
AUTH_SERVICE_URL=http://auth-service:3001

# --- FIX-INS-03 ----------------------------------------------------------------------------------
# Course -> Learning credential: sent in X-Internal-Service-Token to the learning-service's per-course student-progress routes
# (instructor student list / detail, review enrollment check, course-deletion guard). Must be the SAME value as COURSE_LEARNING_TOKEN
# in learning-service and different from every other token. At least 24 printable characters, not a public default; without a
# usable value nothing is sent (no fallback).
# FIX-INS-06: the same Course <-> Learning credential is the ONLY token accepted by this service's internal routes
# GET /api/courses/internal/:courseId/lessons[/:lessonId] (every lesson WITH its videoUrl) and POST /api/courses/recommendations/batch;
# unset / unusable = they refuse every call with 500 (fail-closed). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COURSE_LEARNING_TOKEN=
# Order -> Course credential: the ONLY token accepted by POST /api/courses/:courseId/increment-enrollment (X-Internal-Service-Token).
# Must be the SAME value as ORDER_COURSE_TOKEN in order-service. Unset / unusable = every call is refused with 500 (fail-closed).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_COURSE_TOKEN=
