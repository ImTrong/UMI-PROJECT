{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Authentication service for e-learning platform",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc && tsc prisma/seed.ts --outDir dist-seed --rootDir . --esModuleInterop --module CommonJS --target ES2020 --moduleResolution node",
    "start": "node dist/src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node dist-seed/prisma/seed.js",
    "prisma:reset": "prisma db push --force-reset && npm run prisma:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.9.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.4",
    "prisma": "^5.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "winston": "^3.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.37",
    "@types/nodemailer": "^7.0.11",
    "nodemon": "^3.0.3"
  }
}
