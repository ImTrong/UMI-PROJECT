PORT=3004
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/order_db
AUTH_SERVICE_URL=http://auth-service:3001
COURSE_SERVICE_URL=http://course-service:3003
PAYMENT_SERVICE_URL=http://payment-service:3005

# --- FIX 07B-2A ---------------------------------------------------------------------------------
# Order <-> Payment credential: the ONLY token accepted between order-service and payment-service (sent and checked in the
# X-Internal-Service-Token header). REQUIRED: without it, or with a value shorter than 24 characters / a public default, the
# service refuses to start. Must be the SAME value in order-service and payment-service, and different from every other token
# (INTERNAL_SERVICE_TOKEN, PAYMENT_USER_TOKEN, ...). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_PAYMENT_TOKEN=

# --- FIX-INS-03 ----------------------------------------------------------------------------------
# Order -> Course credential: sent in X-Internal-Service-Token to POST /api/courses/:courseId/increment-enrollment after an order
# is fulfilled. Must be the SAME value as ORDER_COURSE_TOKEN in course-service. Without a usable value the increment is not sent
# (logged as an error; the enrollment itself still happens). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_COURSE_TOKEN=

# --- FIX-INS-04 ----------------------------------------------------------------------------------
# Order <-> Learning credential: sent to POST /api/learning/internal/courses/:courseId/enroll and checked on
# GET /api/orders/internal/:orderId/entitlement (the learning-service's payment check). Must be the SAME value as
# ORDER_LEARNING_TOKEN in learning-service. Without a usable value no course is granted (logged; nothing falls back to
# INTERNAL_SERVICE_TOKEN). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_LEARNING_TOKEN=
