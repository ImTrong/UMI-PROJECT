datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==================== AI Chat System ====================

model Conversation {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  title     String    @default("Cuộc trò chuyện mới")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId  String   @db.ObjectId
  role            String   // "USER" | "ASSISTANT"
  content         String
  createdAt       DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// ==================== Skill Assessment System ====================

model SkillAssessmentSession {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  careerGoal        String
  status            String   @default("PENDING") // PENDING | ASSESSMENT_REQUIRED | ASSESSMENT_CONTINUE | PROFILE_COMPLETE | ROADMAP_READY
  skillProfile      Json?    // Learner Skill Profile JSON from Prompt 1
  assessmentHistory Json[]   // Array of {round, questions, answers}
  roadmapResult     Json?    // Final roadmap from Prompt 2
  currentRound      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@map("skill_assessment_sessions")
}
