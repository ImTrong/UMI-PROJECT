generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Payment {
  id                    String          @id @default(auto()) @map("_id") @db.ObjectId
  orderId               String?         @db.ObjectId
  orderNumber           String?
  userId                String          @db.ObjectId
  amount                Float
  currency              String          @default("vnd")
  status                PaymentStatus   @default(PENDING)
  type                  PaymentType     @default(COURSE_PURCHASE)
  provider              String          @default("stripe") // "stripe" | "payos"
  stripePaymentIntentId String?
  stripeCustomerId      String?
  paymentMethodId       String?
  clientSecret          String?
  // PayOS fields — stored as String to avoid BSON Int32 overflow; converted to Number at API boundary
  payosOrderCode        String?
  payosPaymentLinkId    String?
  payosCheckoutUrl      String?
  payosQrCode           String?
  // Refund accounting — atomic reservation fields for concurrency-safe refund control
  refundedTotal         Float           @default(0)  // Total successfully refunded
  pendingRefundTotal    Float           @default(0)  // Total reserved by pending/processing refunds
  refundVersion         Int             @default(0)  // Optimistic concurrency control for refund ops
  // Outbox sync fields
  orderSynced           Boolean?        @default(false)
  orderSyncedAt         DateTime?
  syncAttempts          Int             @default(0)
  lastSyncAttemptAt     DateTime?
  lastSyncError         String?
  syncLockUntil         DateTime?
  // Common fields
  errorMessage          String?
  metadata              Json            @default("{}")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  completedAt           DateTime?
  
  refunds               Refund[]
  
  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([orderSynced])
  @@index([stripePaymentIntentId])
  @@index([payosOrderCode])
  @@map("payments")
}

model Refund {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  paymentId         String       @db.ObjectId
  orderId           String?      @db.ObjectId
  orderNumber       String?
  userId            String       @db.ObjectId
  amount            Float
  actualAmount      Float?
  currency          String       @default("vnd")
  reason            String?
  status            RefundStatus @default(PENDING)
  stripeRefundId    String?
  idempotencyKey    String?      @unique // Stripe idempotency key for safe retries
  transferReference String?      // Mã tham chiếu giao dịch chuyển khoản ngân hàng (FT... / mã GD)
  confirmedBy       String?      // ID của admin đã xác nhận hoàn tiền thủ công
  confirmedAt       DateTime?    // Thời điểm admin xác nhận
  notes             String?      // Ghi chú đối soát hoàn tiền
  errorMessage      String?
  createdAt         DateTime     @default(now())
  completedAt       DateTime?
  
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  @@index([paymentId])
  @@index([orderId])
  @@index([status])
  @@index([stripeRefundId])
  @@map("refunds")
}

model StripeEvent {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  stripeEventId     String   @unique
  type              String
  data              Json
  processed         Boolean  @default(false)
  processedAt       DateTime?
  processAttempts   Int      @default(0)
  lastProcessedAt   DateTime?
  processLockUntil  DateTime?  // Distributed lease lock for concurrent workers
  exhausted         Boolean  @default(false) // True when max attempts reached
  error             String?
  createdAt         DateTime @default(now())
  
  @@index([type])
  @@index([processed])
  @@index([processLockUntil])
  @@index([exhausted])
  @@map("stripe_events")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentType {
  COURSE_PURCHASE
  INSTRUCTOR_REGISTRATION
}
