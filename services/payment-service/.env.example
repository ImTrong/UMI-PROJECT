PORT=3005
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/payment_db
AUTH_SERVICE_URL=http://auth-service:3001
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# --- FIX 07B-1 ---------------------------------------------------------------------------------
# Payment -> User credential, sent only to POST /api/users/become-instructor/confirm. REQUIRED for the
# instructor-registration upgrade: without it (or with a value shorter than 24 characters / a public
# default) the call is not sent. Must equal PAYMENT_USER_TOKEN of the user-service. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_USER_TOKEN=
# Demo "mock-complete" payment: development / test only. OFF unless exactly "true"; always OFF when NODE_ENV=production.
PAYMENT_MOCK_ENABLED=false

# --- FIX 07B-2A ---------------------------------------------------------------------------------
# Order <-> Payment credential: the ONLY token accepted between order-service and payment-service (sent and checked in the
# X-Internal-Service-Token header). REQUIRED: without it, or with a value shorter than 24 characters / a public default, the
# service refuses to start. Must be the SAME value in order-service and payment-service, and different from every other token
# (INTERNAL_SERVICE_TOKEN, PAYMENT_USER_TOKEN, ...). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_PAYMENT_TOKEN=
