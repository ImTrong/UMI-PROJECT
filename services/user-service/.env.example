PORT=3002
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/user_db
AUTH_SERVICE_URL=http://auth-service:3001

# Shared secret of the service-to-service routes (/api/users/internal/*: eligibility, notifications). REQUIRED:
# without it every call to those routes is refused. It must equal INTERNAL_SERVICE_TOKEN of the learning service.
# Use a long random value of your own; do not reuse the default of docker-compose.yml.
INTERNAL_SERVICE_TOKEN=change_me_to_a_long_random_secret

# --- FIX 07B-1 ---------------------------------------------------------------------------------
# Payment -> User credential that POST /api/users/become-instructor/confirm accepts (and nothing else does).
# Without it (or with a value shorter than 24 characters / a public default) that route refuses every call.
# Must equal PAYMENT_USER_TOKEN of the payment-service; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_USER_TOKEN=
