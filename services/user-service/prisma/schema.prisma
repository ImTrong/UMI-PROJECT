generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  email       String   @unique
  fullName    String
  avatar      String?
  bio         String?
  role        Role     @default(STUDENT)
  phoneNumber String?
  address     String?
  dateOfBirth DateTime?
  badges      String[] @default([])
  preferences Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  education   EducationBackground[]
  work        WorkExperience[]
  notifications Notification[]
  
  @@map("user_profiles")
}

model EducationBackground {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  institution  String
  degree       String
  fieldOfStudy String
  startDate    DateTime
  endDate      DateTime?
  grade        String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("education_backgrounds")
}

model WorkExperience {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  company     String
  position    String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("work_experiences")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

/// IMPLEMENT-01: a learner's request to become an instructor. Submitting it changes nothing on the profile's role; only an ADMIN
/// approving it turns a STUDENT into an INSTRUCTOR (a rejection keeps the STUDENT, who may apply again).
/// pendingKey enforces "at most ONE pending application per user" in the database: it is the userId while PENDING and
/// "closed:<application id>" once reviewed (MongoDB unique indexes also count null/missing values, so it is never left empty).
model InstructorApplication {
  id              String                      @id @default(auto()) @map("_id") @db.ObjectId
  userId          String                      @db.ObjectId
  expertise       String
  motivation      String?
  status          InstructorApplicationStatus @default(PENDING)
  source          String                      @default("FORM") // "FORM" | "LEGACY_PAYMENT" (a registration fee paid before the review existed)
  pendingKey      String                      @unique
  submittedAt     DateTime                    @default(now())
  reviewedBy      String?                     @db.ObjectId // the ADMIN who decided (always the authenticated caller)
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([userId, submittedAt])
  @@index([status, submittedAt])
  @@map("instructor_applications")
}

enum InstructorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  /// X-Idempotency-Key of the request that created this notification (FIX 06C-4B2B1), kept ONLY for audit / debugging.
  /// Deduplication does NOT rely on it: such a notification's _id is derived from the key (see notification-idempotency.ts)
  /// and MongoDB's unique _id decides. No @unique and no index on purpose: older notifications do not have the field.
  idempotencyKey String?

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ==================== Chat System ====================

model Conversation {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId        String?  @db.ObjectId
  courseTitle     String?
  participants   String[] @db.ObjectId
  lastMessage    String?
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  
  messages       ChatMessage[]
  
  @@index([participants])
  @@index([courseId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ChatMessage {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  conversationId  String      @db.ObjectId
  senderId        String      @db.ObjectId
  senderName      String
  senderAvatar    String?
  content         String
  messageType     MessageType @default(TEXT)
  readBy          String[]    @db.ObjectId
  createdAt       DateTime    @default(now())
  
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}
